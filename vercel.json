{
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://coach-planner-8a3ec.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://coach-planner-8a3ec.firebaseapp.com/__/firebase/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
